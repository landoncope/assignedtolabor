# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical site origin
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cron auth (any long random string; also set in Vercel)
CRON_SECRET=

# Resend (transactional email; the same key is set as the SMTP password in Supabase)
RESEND_API_KEY=

# Cloudflare Turnstile (bot protection). Site key is public. The secret key lives in
# Supabase -> Authentication -> Attack Protection -> Captcha, not in this app.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Dev scripts only: direct Postgres URL (pooler) for scripts/dev/e2e-live.mjs
SUPABASE_DB_URL=

# Instagram posting (Meta app "Assigned To Labor", app id 1447625173912481; the Instagram
# product has its own id/secret under Use cases -> Customize -> API setup with Instagram login).
# The secret is pasted by Landon; it is never typed by Claude.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Dashboard (2026-10-30): set to 1 to also ask for instagram_business_manage_insights at
# Connect (reach and views). Only after that permission is added to the Meta app, or
# Instagram refuses the login; teams connected before it reconnect to grant it.
# INSTAGRAM_INSIGHTS=1

# AI-suggested captions (2026-10-15): ElevenLabs Scribe transcribes, Claude drafts.
# Both keys are pasted by Landon; Claude never types them. CAPTION_MODEL is optional.
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
# Only for an organization-level Claude key (one not scoped to a workspace): the workspace to bill.
# ANTHROPIC_WORKSPACE_ID=
# CAPTION_MODEL=claude-sonnet-5-5
